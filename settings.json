{
  "_hooks_note" : "Hook registrations live here under .hooks; no separate hooks\/hooks.json file.",
  "alwaysThinkingEnabled" : true,
  "attribution" : {
    "commit" : "",
    "pr" : "",
    "sessionUrl" : false
  },
  "effortLevel" : "high",
  "enabledPlugins" : {
    "claude-code-setup@claude-plugins-official" : false,
    "claude-mem@thedotmack" : true,
    "codex@openai-codex" : true,
    "frontend-design@claude-plugins-official" : false,
    "mattpocock-skills@mattpocock" : true,
    "skill-creator@claude-plugins-official" : false,
    "typescript-lsp@claude-plugins-official" : false,
    "visual-explainer@visual-explainer-marketplace" : false,
    "waza@waza" : false
  },
  "env" : {
    "CLAUDE_CODE_ATTRIBUTION_HEADER" : "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" : "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS" : "1",
    "CLAUDE_CODE_NO_FLICKER" : "1",
    "DISABLE_AUTOUPDATER" : "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS" : "1",
    "DISABLE_TELEMETRY" : "1",
    "no_proxy" : "localhost,127.0.0.1,::1",
    "NO_PROXY" : "localhost,127.0.0.1,::1"
  },
  "extraKnownMarketplaces" : {
    "claude-plugins-official" : {
      "source" : {
        "repo" : "anthropics\/claude-plugins-official",
        "source" : "github"
      }
    },
    "mattpocock" : {
      "source" : {
        "repo" : "mattpocock\/skills",
        "source" : "github"
      }
    },
    "openai-codex" : {
      "source" : {
        "repo" : "openai\/codex-plugin-cc",
        "source" : "github"
      }
    },
    "thedotmack" : {
      "source" : {
        "repo" : "thedotmack\/claude-mem",
        "source" : "github"
      }
    },
    "visual-explainer-marketplace" : {
      "source" : {
        "repo" : "nicobailon\/visual-explainer",
        "source" : "github"
      }
    },
    "waza" : {
      "source" : {
        "repo" : "tw93\/Waza",
        "source" : "github"
      }
    }
  },
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Applications\/tty7.app\/Contents\/MacOS\/tty7-app\" agent-hook claude notification",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' notification # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' permission-request # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Applications\/tty7.app\/Contents\/MacOS\/tty7-app\" agent-hook claude tool-complete",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' pre-tool-use # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Applications\/tty7.app\/Contents\/MacOS\/tty7-app\" agent-hook claude session-end",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' session-end # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Applications\/tty7.app\/Contents\/MacOS\/tty7-app\" agent-hook claude session-start",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Applications\/tty7.app\/Contents\/MacOS\/tty7-app\" agent-hook claude stop",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' stop # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' stop-failure # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "codegraph prompt-hook",
            "shell" : "bash",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Applications\/tty7.app\/Contents\/MacOS\/tty7-app\" agent-hook claude prompt-submit",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "'$HOME\/Library\/Application Support\/Muxy\/hooks\/muxy-claude-hook.sh' user-prompt-submit # muxy-notification-hook",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : ""
      }
    ]
  },
  "model" : "opus[1m]",
  "permissions" : {
    "allow" : [
      "Skill(codex-skill)",
      "Skill(claude-code-settings:codex-skill)",
      "Skill(nanobanana-skill)",
      "Skill(claude-code-settings:nanobanana-skill)",
      "Skill(youtube-transcribe-skill)",
      "Skill(claude-code-settings:youtube-transcribe-skill)",
      "Skill(autonomous-skill)",
      "Skill(claude-code-settings:autonomous-skill)",
      "Bash(codex:*)",
      "mcp__codegraph__*"
    ],
    "ask" : [
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(npm publish:*)",
      "Bash(eval:*)"
    ],
    "defaultMode" : "auto",
    "deny" : [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**\/.env)",
      "Read(**\/.env.*)",
      "Read(~\/.ssh\/**)",
      "Read(~\/.aws\/**)",
      "Read(**\/*credential*)",
      "Read(**\/*secret*)",
      "Read(**\/*.pem)",
      "Read(**\/*.key)"
    ]
  },
  "promptSuggestionEnabled" : false,
  "skipDangerousModePermissionPrompt" : true,
  "statusLine" : {
    "command" : "~\/.claude\/status-line\/context-bar.sh",
    "padding" : 0,
    "refreshInterval" : 10,
    "type" : "command"
  },
  "theme" : "light"
}