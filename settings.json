{
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1",
    "no_proxy": "localhost,127.0.0.1,::1",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Skill(codex-skill)",
      "Skill(claude-code-settings:codex-skill)",
      "Skill(nanobanana-skill)",
      "Skill(claude-code-settings:nanobanana-skill)",
      "Skill(youtube-transcribe-skill)",
      "Skill(claude-code-settings:youtube-transcribe-skill)",
      "Skill(autonomous-skill)",
      "Skill(claude-code-settings:autonomous-skill)",
      "Bash(codex:*)",
      "Bash(eza:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(echo:*)",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(npm publish:*)",
      "Bash(eval:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/block-git-destructive.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/block-env-dump.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/enforce-modern-cli.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/gh-json.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/redirect-to-anvil.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/status-line/context-bar.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "codex@openai-codex": true,
    "frontend-design@claude-plugins-official": false,
    "mattpocock-skills@mattpocock": true,
    "skill-creator@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "visual-explainer@visual-explainer-marketplace": false,
    "waza@waza": false,
    "ponytail@ponytail": true,
    "nowledge-mem@nowledge-community": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    },
    "waza": {
      "source": {
        "source": "github",
        "repo": "tw93/Waza"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "nowledge-community": {
      "source": {
        "source": "git",
        "url": "https://github.com/nowledge-co/community.git"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "_hooks_note": "Hook registrations live here under .hooks; no separate hooks/hooks.json file.",
  "model": "opus"
}
